# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4400
NODE_ENV=development
CLIENT_URL=http://localhost:4321

# ─── Database & Auth ─────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/database?retryWrites=true&w=majority

# REQUIRED. The server refuses to boot without this — there is deliberately no
# fallback, since a default baked into the repo is a publicly known secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# OPTIONAL. Enables GET /api/v1/user/pass-less, the master login bypass, which
# only accepts requests carrying this exact value in an `x-root-key` header.
# Leave it unset and the endpoint returns 404.
ROOT_BYPASS_KEY=

# OPTIONAL, non-production only. Enables the Socket.IO Admin UI behind basic
# auth. Leave unset and the admin namespace is not mounted at all.
SOCKET_ADMIN_USERNAME=admin
SOCKET_ADMIN_PASSWORD=

# ─── AWS S3 Cloud Storage ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=cnppromo-files

# ─── Brevo SMTP Email Relay (password reset mails) ───────────────────────────
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_FROM=support@cnppromo.com
